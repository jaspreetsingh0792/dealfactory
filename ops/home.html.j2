{% from 'storefront.html.j2' import head, header, footer with context %}
{% set faqs = [
  ("Is DealFactory free?", "Yes. DealFactory is free, open source and has no ads. If you connect a paid AI provider, that provider may charge for the searches you run."),
  ("Does DealFactory read my email?", "Only if you join the limited Gmail beta. Google's testing mode allows at most 100 people while verification is pending. Everyone else adds devices by hand. The browser searches receipts with read-only access, removes recognizable personal details and sends excerpts to the AI provider you choose. DealFactory's server never receives your Gmail access or receipt text."),
  ("What kinds of products does it help with?", "Anything that has to work with what you already own — especially smart-home devices (Matter, Zigbee, Thread, Apple Home, Google Home, Home Assistant), smart thermostats, TVs and soundbars, and appliance filters or parts."),
  ("Do I need an account?", "No. Your setup is saved in your browser. You can export it as a file at any time or delete it with one click."),
  ("Does DealFactory sell products?", "No. It checks compatibility and links straight to the retailer page, so you can verify the price and buy wherever you like."),
  ("Which AI does it use?", "The one you choose. Sign in with OpenRouter, open your brief in Claude or ChatGPT, or connect any MCP tool."),
] %}
{% set entries = [] %}{% for question, answer in faqs %}{% set _ = entries.append({"@type": "Question", "name": question, "acceptedAnswer": {"@type": "Answer", "text": answer}}) %}{% endfor %}
<!doctype html><html lang="en"><head>
{{ head("DealFactory | Buy what fits your home", "DealFactory remembers the smart-home devices and appliances you already own, from Gmail receipts or items you add, and checks every suggestion for compatibility and live store prices.", "/") }}
<script type="module" src="/lib/storefront.js"></script>
<script type="application/ld+json">{{ {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": entries} | tojson }}</script>
<script type="application/ld+json">{{ {"@context": "https://schema.org", "@graph": [
  {"@type": "WebSite", "name": "DealFactory", "url": site_url + "/", "description": "DealFactory remembers the smart-home devices and appliances you already own and checks compatibility and live store prices."},
  {"@type": "SoftwareApplication", "name": "DealFactory", "applicationCategory": "LifestyleApplication", "operatingSystem": "Web", "url": site_url + "/advisor/", "offers": {"@type": "Offer", "price": "0", "priceCurrency": "EUR"}, "description": "Free browser shopping memory for smart-home and appliance compatibility. Bring your own AI."}
]} | tojson }}</script>
</head><body class="store home">
{{ header() }}
<main id="main" class="frame">
  <section class="memory-hero" aria-labelledby="memory-title">
    <div class="memory-copy">
      <div class="label light"><span class="rule"></span>YOUR HOME'S SHOPPING MEMORY</div>
      <h1 id="memory-title">Buy what fits <em>your home.</em></h1>
      <p>DealFactory remembers the smart-home devices and appliances you already own — from Gmail receipts or items you add — and checks every suggestion for compatibility and live store prices.</p>
      <div class="hero-actions"><a class="cta" href="/advisor/#setup">Build your setup <span aria-hidden="true">↗</span></a><a class="ghost" href="#how">How it works <span aria-hidden="true">↓</span></a></div>
      <ul class="promises" aria-label="Promises"><li>Fit before price</li><li>No ads</li><li>Free and open source</li></ul>
    </div>
    <figure class="memory-card" aria-label="Example of a DealFactory home setup and compatibility suggestion">
      <div class="memory-card-head"><strong>Your home setup</strong><span>Example</span></div>
      <ul class="owned-list">
        <li><i aria-hidden="true">◐</i><div><b>Philips Hue Bridge</b><small>Smart home · Apple Home &amp; Matter</small></div><span class="source gmail">From a Gmail receipt</span></li>
        <li><i aria-hidden="true">◑</i><div><b>Intergas Kombi Kompakt</b><small>OpenTherm boiler</small></div><span class="source">Added by you</span></li>
        <li><i aria-hidden="true">◒</i><div><b>LG C2, 55 inch</b><small>OLED TV · HDMI eARC</small></div><span class="source">Confirmed</span></li>
      </ul>
      <p class="ask"><span>You ask</span>“A smart thermostat that works with Apple Home, under €200”</p>
      <div class="suggestion">
        <div class="suggestion-head"><span class="label">COMPATIBILITY CHECK</span><b>Matter smart thermostat with OpenTherm</b></div>
        <ul><li>Modulates your Intergas boiler over OpenTherm</li><li>Pairs natively with Apple Home over Matter</li><li>Price quote linked to the live retailer page</li></ul>
      </div>
    </figure>
  </section>

  <section class="steps" id="how" aria-labelledby="how-title">
    <div class="section-head"><div><div class="label"><span class="rule"></span>HOW IT WORKS</div><h2 id="how-title">Three steps<span>.</span></h2></div></div>
    <ol class="step-grid">
      <li><span class="step-no">01</span><h3>Add what you own</h3><p>Type your hubs, boiler, TV and appliances. A starter preset fills a typical home. Gmail import is a limited beta for at most 100 test users while Google reviews the app.</p></li>
      <li><span class="step-no">02</span><h3>Ask for what you need</h3><p>Describe the device, accessory or replacement filter you need. DealFactory attaches your home setup, protocols, country and currency.</p></li>
      <li><span class="step-no">03</span><h3>Verify fit and price</h3><p>Every pick is checked against what you own, with a direct retailer link and a live price quote you can confirm at the shop.</p></li>
    </ol>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="label"><span class="rule"></span>WHY DEALFACTORY</div>
    <h2 id="why-title">Built around <em>your home,</em> not a marketplace.</h2>
    <div class="why-grid">
      <div><h3>Fit comes first</h3><p>Protocols, hubs, mounts and model generations are checked before price.</p></div>
      <div><h3>Every store</h3><p>Not tied to Google, Amazon or Shopify. Suggestions link straight to the retailer.</p></div>
      <div><h3>Portable to any AI</h3><p>Your setup is an open <a href="https://github.com/jaspreetsingh0792/dealfactory/blob/main/spec/shopping-context.md">Shopping Context</a> file for Claude, ChatGPT or any MCP tool.</p></div>
      <div><h3>Private by design</h3><p>Saved in your browser. Zero ads, and Gmail receipts never touch our server.</p></div>
    </div>
  </section>

  <aside class="advisor-strip ai-strip"><div><div class="label"><span class="rule"></span>BRING YOUR OWN AI</div><h2>Use the AI <em>you already have.</em></h2><p>Sign in with OpenRouter, open your brief in Claude or ChatGPT, or plug in our MCP price verifier. DealFactory never charges for AI.</p></div><a class="dark-button" href="/advisor/#connect">Connect your AI <span aria-hidden="true">↗</span></a></aside>

  <section class="explore" aria-labelledby="explore-title">
    <div class="section-head"><div><div class="label"><span class="rule"></span>COMPATIBILITY GUIDES</div><h2 id="explore-title">Start with a guide<span>.</span></h2></div></div>
    <div class="explore-grid">
      <a class="explore-card dark-card" href="/guides/smart-home-compatibility/"><span class="label light"><span class="rule"></span>SMART HOME &amp; APPLIANCES</span><h3>Smart home &amp; appliance fit guide</h3><p>Matter vs. Zigbee, OpenTherm boilers, HDMI eARC soundbars, and replacement filters — what to check before you order.</p><span class="go" aria-hidden="true">↗</span></a>
      <a class="explore-card" href="/deals/"><span class="label"><span class="rule"></span>CHECKED DEALS</span><h3>{% if offers %}{{ offers|length }} in-stock {{ "offer" if offers|length == 1 else "offers" }}{% else %}Retailer offers{% endif %}</h3><p>{% if offers %}Live prices checked at NL and EU retailers on <time datetime="{{ checked_at }}">{{ checked_label }}</time>.{% else %}Verified NL and EU retailer offers with links to each shop.{% endif %}</p><span class="go" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="label"><span class="rule"></span>QUESTIONS</div>
    <h2 id="faq-title">Good to know<span>.</span></h2>
    <div class="faq-list">{% for question, answer in faqs %}<details><summary>{{ question }}</summary><p>{{ answer }}</p></details>{% endfor %}</div>
  </section>

  <section class="closing" aria-labelledby="closing-title"><h2 id="closing-title">Start your <em>home memory.</em></h2><p>It takes a minute to add your first hub, TV or appliance.</p><a class="cta" href="/advisor/#setup">Build your setup <span aria-hidden="true">↗</span></a></section>
</main>{{ footer() }}</body></html>
