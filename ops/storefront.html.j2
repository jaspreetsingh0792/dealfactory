{% macro wordmark(root="/") -%}
<a class="wordmark" href="{{ root }}" aria-label="DealFactory home"><i class="tag-mark" aria-hidden="true"></i>DealFactory<span class="brand-period">.</span></a>
{%- endmacro %}
{% macro head(title, description, path, image="/media/home-setup.png") %}
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'none'">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site_url }}{{ path }}">
<meta property="og:image" content="{{ site_url }}{{ image }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site_url }}{{ image }}">
<meta name="theme-color" content="#182e20">
<link rel="icon" href="/media/favicon.svg" type="image/svg+xml">
<link rel="canonical" href="{{ site_url }}{{ path }}"><link rel="stylesheet" href="/storefront.css">
<link rel="preload" href="/media/InstrumentSerif-Italic.ttf" as="font" type="font/ttf" crossorigin>
{% endmacro %}
{% macro header(current="") %}
<a class="skip" href="#main">Skip to content</a>
<header class="mast"><div class="frame mast-inner">
  {{ wordmark() }}
  <nav aria-label="Main navigation"><a class="nav-secondary" href="/#how">How it works</a><a class="nav-secondary"{% if current == "smarthome" %} aria-current="page"{% endif %} href="/guides/smart-home-compatibility/">Smart home guide</a><a class="nav-secondary"{% if current == "deals" %} aria-current="page"{% endif %} href="/deals/">Deals</a><a class="advisor-link" href="/advisor/">Open your advisor <span aria-hidden="true">↗</span></a></nav>
</div></header>
{% endmacro %}
{% macro footer() %}
<footer class="foot"><div class="frame foot-inner">{{ wordmark() }}<nav aria-label="Footer navigation"><a href="/advisor/">Shopping advisor</a><a href="/deals/">Deals</a><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="https://github.com/jaspreetsingh0792/dealfactory">Source code <span aria-hidden="true">↗</span></a></nav></div></footer>
{% endmacro %}
{% macro offer_grid(offers, checked_at, guide=false) %}
<div class="section-head" id="shortlist">
  <div><div class="label"><span class="rule"></span>DUTCH RETAILERS</div><h2>{% if guide %}Checked retailer offers{% else %}The shortlist<span>.</span>{% endif %}</h2></div>
  {% if offers %}<p class="dateline">Last checked <time datetime="{{ checked_at }}">{{ checked_label }}</time></p>{% endif %}
</div>
<div id="unverified-offers" class="empty-state"{% if offers %} hidden{% endif %}><strong>Check prices with the retailer.</strong> <a href="/guides/smart-home-compatibility/">Read the compatibility guide <span aria-hidden="true">→</span></a></div>
{% if offers %}
<div data-offers-checked="{{ checked_at }}">
  <div class="controls">
    <div class="filters" role="group" aria-label="Filter by retailer"><button type="button" data-filter="" aria-pressed="true">All offers <small>{{ offers|length }}</small></button>{% for retailer in offers|map(attribute='retailer')|unique|sort %}<button type="button" data-filter="{{ retailer }}" aria-pressed="false">{{ retailer }}</button>{% endfor %}</div>
    <label class="sort"><span class="sr-only">Sort offers</span><select id="offer-sort" aria-label="Sort offers"><option value="asc">Price: low to high</option><option value="desc">Price: high to low</option><option value="name">Name: A to Z</option></select></label>
  </div>
  <div class="products" id="offer-grid">
    {% for offer in offers %}
    <article class="product" data-shop="{{ offer.retailer }}" data-price="{{ offer.price|replace(',', '.') }}" data-name="{{ offer.name }}">
      <a class="product-target" data-retailer href="{{ offer.url }}">
        <div class="product-image">
          <span class="image-fallback" aria-hidden="true">{{ offer.retailer }}</span>
          {% if offer.image %}<img src="{{ offer.image }}" loading="lazy" decoding="async" alt="" referrerpolicy="no-referrer">{% endif %}
          {% if offer.previous %}<span class="reduction">Price drop</span>{% endif %}
        </div>
        <div class="product-info"><span class="product-brand">{{ offer.retailer }}</span><h3>{{ offer.name }}</h3>
          {% if offer.fits %}<p class="fits">Fits: {{ offer.fits }}</p>{% endif %}
          <div class="price-line"><strong>€{{ offer.price }}</strong><span class="go" aria-hidden="true">↗</span></div>
          {% if offer.previous %}<small class="previous"> · previously €{{ offer.previous }} on {{ offer.previous_date }}</small>{% endif %}
        </div>
      </a>
    </article>
    {% endfor %}
  </div>
  <p class="sr-only" id="filter-feedback" role="status"></p>
</div>
{% endif %}
{% endmacro %}
{% if deals %}
<!doctype html><html lang="en"><head>
{{ head("Checked smart home and appliance deals | DealFactory", "In-stock smart-home and appliance offers from NL and EU retailers, with euro prices DealFactory checked on the shop page.", "/deals/") }}
<script type="module" src="/lib/storefront.js"></script><script type="module" src="/lib/fresh-offers.js"></script>
{% set deal_items = [] %}
{% for offer in offers %}
{% set product = {"@type": "Product", "name": offer.name, "offers": {"@type": "Offer", "priceCurrency": "EUR", "price": offer.price|replace(',', '.'), "availability": "https://schema.org/InStock", "url": offer.url, "seller": {"@type": "Organization", "name": offer.retailer}}} %}
{% if offer.image %}{% set _ = product.update({"image": offer.image}) %}{% endif %}
{% set _ = deal_items.append({"@type": "ListItem", "position": loop.index, "item": product}) %}
{% endfor %}
<script type="application/ld+json">{{ {"@context": "https://schema.org", "@graph": [
  {"@type": "ItemList", "name": "Checked smart home and appliance deals", "itemListElement": deal_items},
  {"@type": "BreadcrumbList", "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "DealFactory", "item": site_url + "/"},
    {"@type": "ListItem", "position": 2, "name": "Deals", "item": site_url + "/deals/"}
  ]}
]} | tojson }}</script>
</head><body class="store">
{{ header("deals") }}
<main id="main" class="frame">
  <section class="cover" aria-labelledby="cover-title">
    <div class="cover-copy">
      <div class="label light"><span class="rule"></span>CHECKED DEALS</div>
      <h1 id="cover-title">Smart home<br><em>that fits.</em></h1>
      <p>Hubs, thermostats, plugs and filters in stock at NL and EU shops, with the price read from the retailer page.</p>
      <a class="cta" href="/guides/smart-home-compatibility/">Read the compatibility guide <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="collection" aria-label="Retailer offers">{{ offer_grid(offers, checked_at) }}</section>
  <aside class="advisor-strip"><div><div class="label"><span class="rule"></span>SHOPPING ADVISOR</div><h2>Will it fit <em>your home?</em></h2><p>Add the hub, boiler or appliance you own and the advisor checks the next purchase against it.</p></div><a class="dark-button" href="/advisor/#setup">Add what you own <span aria-hidden="true">↗</span></a></aside>
</main>{{ footer() }}</body></html>
{% endif %}
