{% from 'storefront.html.j2' import header, footer, offer_grid with context %}
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'none'">
<title>Stroller footmuffs in the Netherlands | DealFactory</title>
<meta name="description" content="Find a footmuff that fits your stroller, compare checked Dutch retailer prices, and see what to verify before ordering.">
<meta property="og:title" content="Stroller footmuffs in the Netherlands | DealFactory">
<meta property="og:description" content="Check stroller fit and compare in-stock retailer offers with checked prices.">
<meta property="og:url" content="{{ site_url }}/guides/stroller-footmuffs/">
<meta property="og:image" content="{{ site_url }}/media/winter-walk.webp">
<link rel="canonical" href="{{ site_url }}/guides/stroller-footmuffs/">
<link rel="stylesheet" href="/storefront.css">
<script type="module" src="/lib/storefront.js"></script><script type="module" src="/lib/fresh-offers.js"></script>
</head><body class="store">
{{ header("guide") }}
<main id="main" class="frame">
  <section class="guide-cover">
    <div class="guide-title"><a class="crumb" href="/">← Back to DealFactory</a><div class="label"><span class="rule"></span>BUYING GUIDE</div><h1>Stroller<br><em>footmuffs.</em></h1><p>Compare offers in the Netherlands and check the fit for your stroller before ordering.</p><a class="dark-button" href="#shortlist">Jump to offers <span aria-hidden="true">↓</span></a></div>
    <div class="guide-photo" role="img" aria-label="Winter stroller on a woodland path"></div>
  </section>
  {% if offers_first %}<section class="collection">{{ offer_grid(offers, checked_at, true) }}</section>{% endif %}
  <section class="field-notes"><div class="label"><span class="rule"></span>FIT NOTES</div><h2>What to check before ordering</h2>
    <div class="notes-grid"><div><h3>Model &amp; generation</h3><p>Look for your exact stroller model on the manufacturer’s compatibility list.</p></div><div><h3>Harness openings</h3><p>Check that the harness slots line up with your seat and follow its fitting instructions.</p></div><div><h3>Delivered price</h3><p>Check delivery charges and return terms for your postcode before ordering.</p></div></div>
  </section>
  {% if not offers_first %}<section class="collection">{{ offer_grid(offers, checked_at, true) }}</section>{% endif %}
  <section class="sources" id="retailers"><div><h2>Retailer sources</h2><p>Prices are checked in euros, before delivery. Confirm current stock at the shop.</p></div><div class="source-links">{% for source in sources %}<a data-retailer href="{{ source.url }}">{{ source.name }} at {{ source.retailer }} <span aria-hidden="true">↗</span></a>{% endfor %}<button class="dark-button" id="share-guide" hidden>Share this guide ↗</button></div></section>
</main>{{ footer() }}</body></html>
