<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{% block title %}DealFactory{% endblock %}</title>
<link rel="stylesheet" href="{{ root }}assets/style.css">
</head>
<body>
<div class="wrap">
<header class="site">
  <a class="brand" href="{{ root }}index.html">DealFactory</a>
  <nav>
    <a href="{{ root }}index.html">Needs</a>
    {% if not public %}<a href="{{ root }}private/environment.html">My environment</a>
    <a href="{{ root }}private/inventory.html">Purchases</a>{% endif %}
  </nav>
  <span class="meta">Built {{ generated }}{% if public %} · public build{% endif %}</span>
</header>
{% block body %}{% endblock %}
<footer>
  Facts (<span class="tag fact">fact</span>) come from the linked pages, with the time they were read.
  <span class="tag judgement">AI judgement</span> marks Claude's reasoning about those facts.
  “unknown” means no source stated it. Prices can change; check the retailer before buying.
</footer>
</div>
</body>
</html>
